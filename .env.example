# ========================================================
# PRINT WITH AI - Environment Configuration Example
# Copy this file to .env or set corresponding environment variables
# ========================================================

# Application Port
SERVER_PORT=8085

# Active Spring Profile (demo for H2 in-memory, mysql for MySQL 8)
SPRING_PROFILES_ACTIVE=demo

# Base URL for Kiosk QR Codes and Redirects
APP_BASE_URL=http://localhost:8085

# Upload Storage Directory (Outside Web Root)
APP_UPLOAD_DIR=./uploads
APP_UPLOAD_MAX_FILE_SIZE=10MB

# File Retention Period in Minutes for Scheduled Cleanup
APP_STORAGE_RETENTION_MINUTES=60

# Pricing Configuration (Demonstration Rates in INR)
APP_PRICING_BW_PER_PAGE=2.00
APP_PRICING_COLOR_PER_PAGE=8.00
APP_PRICING_DUPLEX_DISCOUNT=0.50

# Default Admin Seed Credentials (Change before production!)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# UPI Payment Settings (PhonePe / GPay / Paytm / BHIM)
UPI_VPA=7820939263@ibl
UPI_PAYEE_NAME=Omkar Vilas Sarpane
OPERATOR_PIN=1234

# Optional Local AI Integration (Ollama)
OLLAMA_ENABLED=false
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=3000

# MySQL Production Database Settings (Only used when SPRING_PROFILES_ACTIVE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=printwithai_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
